  "project": "Loan approval prediction",
  "author": "Ladarius Jackson",
  "dataset": {
    "name": "Lending Club loan sample (OpenML Lending-Club-Loan-Data)",
    "openml_name": "Lending-Club-Loan-Data",
    "openml_id": 43729,
    "openml_url": "https://www.openml.org/d/43729",
    "parquet_url": "https://data.openml.org/datasets/0004/43729/dataset_43729.pq",
    "license": "CC0: Public Domain",
    "license_notes": "OpenML data id 43729 records its licence field as 'CC0: Public Domain'. The table is a public 9,578-loan extract with a repayment label. It is not the full Lending Club servicing tape. This project caches that entire extract at data/lending_club_sample.csv so training, tests, CI, and the app run offline, with no account and no network.",
    "citation": "Lending-Club-Loan-Data. OpenML data id 43729. https://www.openml.org/d/43729. Licence recorded by OpenML: CC0: Public Domain.",
    "fetched_with": "sklearn.datasets.fetch_openml(data_id=43729, as_frame=True)",
    "target_definition": "not_fully_paid is 1 when the borrower did not fully repay and 0 when the loan was fully paid. The model scores the chance the loan is fully paid and approves when that chance clears the cost cutoff."
  },
  "positive_class": "fully paid, coded as 1, decision = approve",
  "positive_rate": 0.8399457089162664,
  "policy": {
    "excluded_features": [
      "credit_policy",
      "int_rate"
    ],
    "reason": "credit_policy is Lending Club's own underwriting flag, and int_rate is the interest rate the platform assigned from its risk grade. Both already contain a lender's judgment. The deployed score does not see them, so the desk can explain the application rather than repeat the old price. A side comparison puts the two fields back at the winning hyperparameters and does not get to pick the model. FICO stays in the score because it is known from the credit file at application time. A second refit drops FICO so the report can show how much of the ranking the score itself carries.",
    "ablation_feature": "fico",
    "fp_cost": 5000.0,
    "fn_cost": 600.0,
    "cost_source": "Planning scenario in dollars, not observed recoveries. The extract has no loan term and no charge-off balance. At the sample mean interest rate (12.264%) and mean monthly installment ($319.09), a 36-month amortizing loan implies about $9,571 of principal and about $1,917 of gross interest. Funding a loan that is not fully paid is priced at $5,000, near half of that principal sketch. Declining a loan that would have been fully paid is priced at $600, below that gross interest, as a stand-in for forgone net contribution after funding costs the file does not record. A different pair of weights needs a different cutoff. The probability is saved separately so the desk can move the cutoff without refitting.",
    "review_band": 0.05
  },
